/*
 * Minimal split PERIPHERAL shield, used only by CI.
 *
 * Same fictional matrix as the dongle, and the same shared keymap: the point of
 * this target is that a peripheral compiles every binding the keymap names
 * while having no display shield, no theme nodes and no dial.
 *
 * The 2x2 matrix is a fiction. ZMK requires a transform and a keymap of
 * matching size; four positions satisfy that and leave room to bind this
 * module's behaviours as they arrive.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan0;
        /* Defining the transform is not enough — ZMK resolves
         * zmk_matrix_transform_default through this chosen entry, and the link
         * fails on an undefined reference without it. */
        zmk,matrix-transform = &keymap_transform_0;
    };

    keymap_transform_0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3)
RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };

    mock_kscan0: mock_kscan0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
