/*
 * Minimal dongle shield, used only by CI.
 *
 * A dongle is a split central with no keys of its own, and that is all this
 * describes.
 *
 * The 2x4 matrix is a fiction. ZMK requires a transform and a keymap of
 * matching size; eight positions satisfy that and leave room to bind this
 * module's behaviours as they arrive — every one of them is bound, so CI fails
 * if a behaviour stops resolving rather than only if the widgets stop
 * compiling.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan0;
        /* Defining the transform is not enough — ZMK resolves
         * zmk_matrix_transform_default through this chosen entry, and the link
         * fails on an undefined reference without it. */
        zmk,matrix-transform = &keymap_transform_0;

        /* The palette a block starts in. It lives HERE, in the consumer's
         * dongle-only shield, because the theme nodes come from the module's
         * display overlay: a reference from the shared keymap would fail every
         * split half with "undefined node label", and the peripheral target
         * next door exists to prove that stays true. */
        zmk,focus-theme = &focus_violet;
    };

    keymap_transform_0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3)
RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };

    mock_kscan0: mock_kscan0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
