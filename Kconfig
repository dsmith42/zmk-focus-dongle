# Option names and wording derived from carrefinho/prospector-zmk-module (MIT) —
# see NOTICE. Changed: the ambient light sensor option now defaults off and says
# it is unsupported; options for features this module does not have are dropped.

config FOCUS_DONGLE_ROTATE_DISPLAY_180
    bool "Rotate the display 180 degrees"
    default n

config FOCUS_DONGLE_USE_AMBIENT_LIGHT_SENSOR
    bool "Use an ambient light sensor for auto brightness"
    default n
    help
      Unsupported. The Prospector's ambient light sensor is an optional add-on
      breakout rather than a populated part, and this build has none, so the
      code path has never been tested against hardware. Left here because
      brightness.c still carries the branch. Fixed brightness is the default.

config FOCUS_DONGLE_FIXED_BRIGHTNESS
    int "Fixed display brightness"
    default 60
    range 1 100
    depends on !FOCUS_DONGLE_USE_AMBIENT_LIGHT_SENSOR
